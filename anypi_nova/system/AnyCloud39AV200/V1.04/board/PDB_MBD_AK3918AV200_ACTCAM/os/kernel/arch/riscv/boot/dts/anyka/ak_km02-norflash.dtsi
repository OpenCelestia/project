        norflash-b-wel = <1>;
        norflash-b-bp0 = <2>;
        norflash-b-bp1 = <3>;
        norflash-b-bp2 = <4>;
		norflash-b-cmp = <6>; 
        norflash-b-srp0 = <7>;
        norflash-b-qe = <9>; 

        status = "disable";
    };
};