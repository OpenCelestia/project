        norflash-flags = <0x18F8>;
		rd_status_cmd = <0x05>, <0x35>, <0x15>;
		wr_status_cmd = <0x01>, <0x31>, <0x11>;
		wr_mode = <1>;
		norflash-wr_flags = <2>;

		/* status reg bit map */
