	wifi_en_pins: wifi_en_pins {
		anyka,pins = <XGPIO_000>;
		anyka,function = <XGPIO_000_FUNC_GPIO0>;
		anyka,pull = <(DIR_EN | DIR_OUTPUT | OUTPUT_EN | SLEW_EN | PULL_UP | PULL_UP_EN | OUT_LOW)>;
	};

	wifi_rst_pins: wifi_rst_pins {
		anyka,pins = <XGPIO_001>;
		anyka,function = <XGPIO_001_FUNC_GPIO1>;
		anyka,pull = <(DIR_EN | DIR_OUTPUT | OUTPUT_EN | SLEW_EN | PULL_UP | PULL_UP_EN | OUT_HIGH)>;
	};

	gpio84_low_pins: gpio84_low_pins {
		anyka,pins = <XGPIO_084>;
		anyka,function = <XGPIO_084_FUNC_GPIO84>;
		anyka,pull = <(DIR_EN | DIR_OUTPUT | OUTPUT_EN | SLEW_EN | PULL_DOWN | OUT_LOW)>;
	};

	mipi0_4lane_pins: mipi0_4lane_pins {
		anyka,pins = <	XGPIO_041
						XGPIO_042
