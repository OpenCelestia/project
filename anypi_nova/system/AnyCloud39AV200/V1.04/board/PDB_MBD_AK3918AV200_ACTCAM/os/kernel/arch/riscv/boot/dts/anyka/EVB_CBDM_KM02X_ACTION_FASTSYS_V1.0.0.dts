		anyka,pull = <  (SLEW_EN|DRIVE_SEL0)
                        (SLEW_EN|DRIVE_SEL0)
                        (SLEW_EN|DRIVE_SEL0)
                        (SLEW_EN|DRIVE_SEL0)
                        (SLEW_EN|DRIVE_SEL0)
                        (SLEW_EN|DRIVE_SEL0)
                        (SLEW_EN|DRIVE_SEL0)
                        (SLEW_EN|DRIVE_SEL0)
