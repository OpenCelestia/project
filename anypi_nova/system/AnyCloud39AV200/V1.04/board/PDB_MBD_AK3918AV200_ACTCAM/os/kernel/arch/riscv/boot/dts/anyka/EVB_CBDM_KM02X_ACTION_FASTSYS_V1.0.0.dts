&lcdc {
    pinctrl-names = "default","sleep";
    pinctrl-0 = <&lcd_rgb_pins &lcd_display_pins>;
    pinctrl-1 = <&lcd_rgb_pins_sleep &lcd_display_pins>;
    //power-pins = <&gpio0 XGPIO_019 GPIO_ACTIVE_LOW>;
    /* GPIO19: high=power off, low=LCD_3V3 on */
    backlight-gpio = <&gpio0 XGPIO_019 GPIO_ACTIVE_LOW>;

    //set to resolution ratio
    lcd-logo-width = <800>; //note that need set equal to lcd panel-width at present
    lcd-logo-height = <480>;//note that need set equal to lcd panel-height at present
    //[fmt1:fmt0] 00 16bits input(RGB565 or BGR565)
    //[fmt1:fmt0] 01 24bits input(RGB888 or BGR888)
    //[fmt1:fmt0] 10 or 11 32bits input(ARGB888 ABGR888 RGBA888 BGRA888)
    lcd-logo-fmt0 = <1>;
    lcd-logo-fmt1 = <0>;
    lcd-logo-rgb-seq = <1>; //0 for BGR, 1 for RGB

    lcd-fb-type = <1>; //0:single buffer; 1:double buffer

    status = "okay";

};


&ipu {
    clock-frequency = <450000000>;
    status = "okay";
};

&encrypt {
    status = "okay";
};

&watchdog0 {
    status = "okay";
};

&watchdog1 {
    status = "okay";
};

&fastspi {
    pinctrl-names = "default";
    //pinctrl-0 = <&spiflash_pins &spi_nand_flash_cs_pins>;
    pinctrl-0 = <&spiflash_pins>;
    spi-bus-frequency = <100000000>;
    //spi-bus-frequency = <20000000>;
    /*
     * cap-spi-highspeed;
     * if defined, means high speed controller(Maximum 100M/s);
     * if not, means normal speed controller(below 50M/s)
     */
    cap-spi-highspeed;
    status = "okay";
};

&spi0 {
    pinctrl-names = "default";
    pinctrl-0 = <&spi0_pins>;
    spi-bus-frequency = <50000000>;
    status = "disable";

};

// nor-flash
&spif0 {
    /* spi flash data bus width:
    ** 1 means 1 wire mode.
    ** 2 means 2 wire mode
    ** 4 means 4 wire mode.
    ** default: 4 wire mode.
    **/
    bus-width = <4>;
    //bus-width = <1>;
    status = "okay";
};

