&i2c1 {
    pinctrl-names = "default";
    pinctrl-0 = <&i2c1_pins>;
    clock-frequency = <312000>;
    status = "disable";
};


/*
  开发板的核心板引用i2c2，
  需修改硬件选择i2c
*/
#if IMU
&i2c2 {
    pinctrl-names = "default";
    pinctrl-0 = <&i2c2_pins_imu>;
    clock-frequency = <312000>;
    status = "okay";

    sc7i22: sc7i22@0x19{
        compatible = "anyka,ak-sc7i22";
        reg = <0x19>;
        pinctrl-0 = <&imu_irq_pins>;
        pinctrl-names = "default";
        label = "sc7i22_gpio_intterupt";
        gpios = <&gpio0 XGPIO_020 GPIO_ACTIVE_LOW>; //GPIO_ACTIVE_HIGH 1 GPIO_ACTIVE_LOW 0

        status = "okay";
    };
};
#else
&i2c2 {
    pinctrl-names = "default";
    pinctrl-0 = <&i2c2_pins_tch>;
    /* 40k→400k：GT911 支持 400kHz 快速模式。原 40kHz 使每次传输 ~2ms，
     * 触摸中断线程 90Hz 下烧 ~60% 单核（游戏多指慢放的根因）。 */
    clock-frequency = <400000>;
    status = "okay";

    touch-screen@14 {
        /* 内建主线 goodix 驱动（中断式），替换闭源 ts_gt9xx.ko。
         * 不可同时给 irq-gpios + reset-gpios——两 GPIO 齐全会触发
         * 驱动的"从磁盘加载配置"路径（goodix_911_cfg.bin），而本板
         * firmware_class.ko 在 probe 时段尚未加载，request_firmware_nowait
         * 返回 -22 导致 probe 失败。
         * 不给任何 gpios（中断经 interrupts-extended 获取），让 GPIO10
         * 保持 sysfs 可用，供启动脚本 INT 高脉冲唤醒睡眠态 GT911。 */
        compatible = "goodix,gt911";
        reg = <0x14>;
        pinctrl-names = "default";
        pinctrl-0 = <&gt9xx_pins>;
        /* INT=GPIO0 bank pin10，下降沿；实际触发类型由驱动按 IC 配置决定 */
        interrupts-extended = <&gpio0 10 2>;
        touchscreen-size-x = <800>;
        touchscreen-size-y = <480>;
        status = "okay";
    };
};
#endif


