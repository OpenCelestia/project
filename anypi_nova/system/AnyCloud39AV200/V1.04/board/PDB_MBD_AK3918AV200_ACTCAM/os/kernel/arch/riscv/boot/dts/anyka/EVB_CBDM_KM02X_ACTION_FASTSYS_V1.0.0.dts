					 XGPIO_080   //LCD_D19

					 XGPIO_081   //LCD_D20
					 XGPIO_082   //LCD_D21
					 XGPIO_083   //LCD_D22
					 XGPIO_084 >;//LCD_D23

		anyka,function = <	
                        XGPIO_057_FUNC_RGB_VOGATE
						XGPIO_058_FUNC_RGB_VOVSYNC
						XGPIO_059_FUNC_RGB_VOHSYNC
						XGPIO_060_FUNC_RGB_VOPCLK

                        XGPIO_061_FUNC_RGB_D0
						XGPIO_062_FUNC_RGB_D1
						XGPIO_063_FUNC_RGB_D2
						XGPIO_064_FUNC_RGB_D3
						XGPIO_065_FUNC_RGB_D4
						XGPIO_066_FUNC_RGB_D5
						XGPIO_067_FUNC_RGB_D6
						XGPIO_068_FUNC_RGB_D7
						XGPIO_069_FUNC_RGB_D8
						XGPIO_070_FUNC_RGB_D9
						XGPIO_071_FUNC_RGB_D10
						XGPIO_072_FUNC_RGB_D11
						XGPIO_073_FUNC_RGB_D12
						XGPIO_074_FUNC_RGB_D13
						XGPIO_075_FUNC_RGB_D14
						XGPIO_076_FUNC_RGB_D15
