&pp {
    status = "okay";
};

&i2c0 {
    pinctrl-names = "default";
    pinctrl-0 = <&i2c0_pins>;
    
    clock-frequency = <200000>;
    status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
    
	sensor0: camera@0x10{
		compatible = "anyka,sensor0";
		reg = <0x10>;

		/*0xffff means the gpio is invalid*/
		reset-gpio = <&gpio1 XGPIO_039 1>;
		// pwdn-gpio = <&gpio1 XGPIO_040 1>;

        //reset-gpio = <&gpio1 0xffff 1>;
		pwdn-gpio = <&gpio1 0xffff 1>;

		port {
			sensor0_0: endpoint@0 {
				remote-endpoint = <&vi_0_0>;
			};
		};
	};
#if 0
	sensor1: camera@0x32{
		compatible = "anyka,sensor0";
		reg = <0x32>;

		/*0xffff means the gpio is invalid*/
		reset-gpio = <&gpio1 XGPIO_039 1>;
		pwdn-gpio = <&gpio1 XGPIO_040 1>;
//		reset-gpio = <&gpio1 7 1>;
//		pwdn-gpio = <&gpio1 8 1>;

		port {
			sensor1_0: endpoint@0 {
				remote-endpoint = <&vi_1_0>;
			};
		};
	};
#endif
	/* OV8856 module AF VCM (Fitipower FP5510 @ 0x0c); media port → VI vcm-ep */
	vcm: fp5510@0x0c {
		compatible = "fitipower,fp5510";
		reg = <0x0c>;

		port {
			vcm0_1: endpoint@0 {
				remote-endpoint = <&vi_0_1>;
			};
		};
	};
};

