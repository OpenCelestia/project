	mipi0_3lane_pins: mipi0_3lane_pins {
		anyka,pins = <	XGPIO_041
						XGPIO_042
						XGPIO_043
						XGPIO_044
						XGPIO_045
						XGPIO_046
						XGPIO_047
						XGPIO_048
						XGPIO_049
						XGPIO_050
						XGPIO_051
						XGPIO_052 >;
		anyka,function = <	XGPIO_041_FUNC_MIPI_RX_L0P
							XGPIO_042_FUNC_MIPI_RX_L0N
							XGPIO_043_FUNC_MIPI_RX_L1P
							XGPIO_044_FUNC_MIPI_RX_L1N
							XGPIO_045_FUNC_MIPI_RX_L2P
							XGPIO_046_FUNC_MIPI_RX_L2N
							XGPIO_047_FUNC_MIPI_RX_L3P
							XGPIO_048_FUNC_MIPI_RX_L3N
							XGPIO_049_FUNC_MIPI_RX_L4P
							XGPIO_050_FUNC_MIPI_RX_L4N
							XGPIO_051_FUNC_MIPI_RX_L5P
							XGPIO_052_FUNC_MIPI_RX_L5N	>;
		anyka,pull = <0>;
	};

	mipi0_2lane_pins: mipi0_2lane_pins {
		anyka,pins = <	XGPIO_041
						XGPIO_042
						XGPIO_043
						XGPIO_044
						XGPIO_045
						XGPIO_046 >;
		anyka,function = <	XGPIO_041_FUNC_MIPI_RX_L0P
							XGPIO_042_FUNC_MIPI_RX_L0N
							XGPIO_043_FUNC_MIPI_RX_L1P
							XGPIO_044_FUNC_MIPI_RX_L1N
							XGPIO_045_FUNC_MIPI_RX_L2P
							XGPIO_046_FUNC_MIPI_RX_L2N >;
		anyka,pull = <0>;
	};

	mipi0_1lane_pins: mipi0_1lane_pins {
		anyka,pins = <	XGPIO_041
						XGPIO_042
						XGPIO_043
						XGPIO_044
						XGPIO_045
						XGPIO_046 >;
		anyka,function = <	XGPIO_041_FUNC_MIPI_RX_L0P
							XGPIO_042_FUNC_MIPI_RX_L0N
							XGPIO_043_FUNC_MIPI_RX_L1P
							XGPIO_044_FUNC_MIPI_RX_L1N
							XGPIO_045_FUNC_MIPI_RX_L2P
							XGPIO_046_FUNC_MIPI_RX_L2N >;
		anyka,pull = <0>;
	};

	csi0_sclk_pin: csi0_sclk_pin {
		anyka,pins = <	XGPIO_037 >;
		anyka,function = <	XGPIO_037_FUNC_CSI0_SCLK >;
		/*anyka,pull = <0>;*/
        anyka,pull = <(DRIVE_SEL2)>;
	};
    
    csi1_sclk_pin: csi1_sclk_pin {
        anyka,pins = <  XGPIO_038 >;
        anyka,function = <  XGPIO_038_FUNC_CSI1_SCLK >;
        anyka,pull = <0>;
    };

    // pwm_csi_pins: pwm_csi_pins {
    //     anyka,pins = < XGPIO_053
    //                     XGPIO_054 >;
    //     anyka,function = < XGPIO_053_FUNC_PWM_CSI0
    //                         XGPIO_054_FUNC_PWM_CSI1 >;
    //     anyka,pull = <0>;
    // };

    i2c0_pins: i2c0_pins {
        anyka,pins = <XGPIO_036 XGPIO_035>;
        anyka,function = <XGPIO_036_FUNC_I2C0_SDA XGPIO_035_FUNC_I2C0_SCL>;
        anyka,pull = <(PULL_UP|INPUT_EN|HOLD_EN|DRIVE_SEL2)>;
    };

    i2c1_pins: i2c1_pins {
        anyka,pins = <XGPIO_084 XGPIO_083>;
        anyka,function = <XGPIO_084_FUNC_I2C1_SDA XGPIO_083_FUNC_I2C1_SCL>;
        anyka,pull = <(PULL_UP|INPUT_EN|SLEW_EN|HOLD_EN|DRIVE_SEL0)>;
    };

    //mens
    i2c2_pins_imu: i2c2_pins_imu {
        anyka,pins = <XGPIO_018 XGPIO_017>;
        anyka,function = <XGPIO_018_FUNC_I2C2_SDA XGPIO_017_FUNC_I2C2_SCL>;
        anyka,pull = <(PULL_UP|INPUT_EN|SLEW_EN|HOLD_EN|DRIVE_SEL0)>;
    };

    i2c2_pins_tch: i2c2_pins_tch {
        anyka,pins = <XGPIO_054 XGPIO_053>;
        anyka,function = <XGPIO_054_FUNC_I2C2_SDA XGPIO_053_FUNC_I2C2_SCL>;
        anyka,pull = <(PULL_UP|INPUT_EN|SLEW_EN|HOLD_EN|DRIVE_SEL3)>;
    };

	motor0_pins: motor0_pins {
		anyka,pins = <XGPIO_027 XGPIO_028 XGPIO_029 XGPIO_030>;
		anyka,function = <0>;
		anyka,pull = <PULL_UP>;
	};

	motor1_pins: motor1_pins {
		anyka,pins = <XGPIO_021 XGPIO_022 XGPIO_023 XGPIO_024>;
		anyka,function = <0>;
		anyka,pull = <PULL_UP>;
	};

	pwm0_idle_pins: pwm0_idle_pins {
		anyka,pins = <XGPIO_055>;
		anyka,function = <XGPIO_055_FUNC_GPIO55>;
		anyka,pull = <(DIR_EN | DIR_OUTPUT | OUTPUT_EN | SLEW_EN | PULL_UP | PULL_UP_EN | OUT_LOW)>;
	};

	pwm1_idle_pins: pwm1_idle_pins {
		anyka,pins = <XGPIO_074>;
		anyka,function = <XGPIO_074_FUNC_GPIO74>;
		anyka,pull = <(DIR_EN | DIR_OUTPUT | OUTPUT_EN | SLEW_EN | PULL_UP | PULL_UP_EN | OUT_LOW)>;
	};

    imu_irq_pins: imu-interrupt {
		anyka,pins = <XGPIO_020>;
		anyka,function = <XGPIO_020_FUNC_GPIO20>;
		anyka,pull = <(INPUT_EN  | PULL_DOWN_EN | PULL_DOWN | DIR_INPUT | SLEW_EN)>;
	};

    lcd_display_pins: lcd_display_pins {
		anyka,pins = <XGPIO_003>;
		anyka,function = <XGPIO_003_FUNC_GPIO3>;
		anyka,pull = <(DIR_EN | DIR_OUTPUT | OUTPUT_EN | SLEW_EN | PULL_UP | PULL_UP_EN | DRIVE_SEL7)>;
	};

    spk_en_pins: spk_en_pins {
		anyka,pins = <XGPIO_002>;
		anyka,function = <XGPIO_002_FUNC_GPIO2>;
		anyka,pull = <(DIR_EN | DIR_OUTPUT | OUTPUT_EN | SLEW_EN | PULL_UP | PULL_UP_EN | DRIVE_SEL7)>;
	};

    gt9xx_pins: gt9xx_pins {
        anyka,pins = <XGPIO_010 XGPIO_038>;
        anyka,function = <XGPIO_010_FUNC_GPIO10 XGPIO_038_FUNC_GPIO38>;
        anyka,pull = <(PULL_UP|INPUT_EN|DRIVE_SEL1)>;
    };


};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pins>;
	status = "okay";
};

&uart1 {
	status = "disable";
};

&npu {
	status = "okay";
};

&quick_start {
    dual_mode = <1>;/*dual mode*/
    dual_stitch_mode = <0>;/*dual stitch mode*/
    dual_stitch_idex = <0>;/*0->sensor0 is first, 1->sensor1 is first*/
    dual_sensor0_no_capture = <0>;/*1: no capture, 0: capture*/
    dual_sensor1_no_capture = <0>;/*1: no capture, 0: capture*/

    ae_table_file = "/etc/config/lumi_ae_table.bin";
    day2night_threshold = <6>; /* 6: isp lumi; 82: adc value*/
    night2day_threshold = <7>;
    fastae_mode = <1>;/* 0: init with default ae, 1 : inift with prev backup ae */

    /*light_sensor*/
    light_sensor_enable = <0>; /* if set enable, "day2night_threshold " should set to <82> */
    ain_index =  <1>;/*0 --> ain0, 1 --> ain1*/

    status = "disable";
    venc_chn0_width = <1920>;
    venc_chn0_height = <1080>;
    venc_chn0_fps = <15>;
    venc_chn0_profile = <0>; /*0:H264-main, 4: H265-main, 8:JPEG*/
    venc_chn0_br_mode = <4>; /*0:cbr, 1: vbr, 4:avbr*/
    venc_chn0_initqp = <100>;
    venc_chn0_minqp = <25>;
    venc_chn0_maxqp = <48>;
    venc_chn0_maxbitrate = <1024>;
    venc_chn0_enc_level = <50>;
    venc_chn0_enc_out_type = <0>; /* 0:H264, 1:JPEG, 2:H265 */
    venc_chn0_max_frame_size = <0>; /* output stream buf szie(KB), 0: use default size */

    venc_chn1_bind_vi_chn = <2>; /* VIDEO_CHN2 */
    venc_chn1_width = <1920>;
    venc_chn1_height = <1080>;
    venc_chn1_fps = <15>;
    venc_chn1_profile = <8>; /*0:H264-main, 4: H265-main, 8:JPEG*/
    venc_chn1_br_mode = <1>; /*0:cbr, 1: vbr*/
    venc_chn1_initqp = <50>;
    venc_chn1_minqp = <25>;
    venc_chn1_maxqp = <50>;
    venc_chn1_maxbitrate = <1024>;
    venc_chn1_enc_level = <50>;
    venc_chn1_enc_out_type = <0>; /* 0:H264, 1:JPEG, 2:H265 */

    dev0_attr{
        vi_config_file = "/etc/config/vi_config.bin";
        //main chn info
        main_channel_width = <1920>;
        main_channel_height = <1080>;
        main_venc_mode = <1>;/*0:encode frame in user layer, 1:encode frame in kernel layer;*/
        main_chn_mode = <0>;/*0->fream, 1->slice*/
        main_chn_buf = <3>;/*fream:yuv buffer,  slice:slice num*/

        //sub chn info
        sub_channel_width = <640>;
        sub_channel_height = <360>;
        sub_venc_mode = <1>;/*0:encode frame in user layer, 1:encode frame in kernel layer;*/
        sub_chn_mode = <0>;/*0->fream, only frame*/
        sub_chn_buf = <3>;/*fream:yuv buffer*/

        //thd chn info
        third_channel_width = <320>;
        third_channel_height = <180>;
        thd_encode_mode = <1>;/*0:encode frame in user layer, 1:encode frame in kernel layer;*/
        thd_chn_mode = <0>;/*0->fream, only frame*/
        thd_chn_buf = <3>;/*fream:yuv buffer*/

        crop_left = <0>;
        crop_top = <0>;
        crop_width = <0>;
        crop_height = <0>;

        //main chn crop info
        main_crop_left = <0>;
        main_crop_top = <0>;
        main_crop_width = <0>;
        main_crop_height = <0>;

        //sub chn crop info
        sub_crop_left = <0>;
        sub_crop_top = <0>;
        sub_crop_width = <0>;
        sub_crop_height = <0>;

        //thd chn crop info
        thd_crop_left = <0>;
        thd_crop_top = <0>;
        thd_crop_width = <0>;
        thd_crop_height = <0>;

        day_night_mode_select = <0>; /* 0:irfeed light; 1: white light; 2: always day mode with light off;  3: always night mode with light on; 4: always day mode with light on;*/
        ircut_a_gpio = <&gpio1 XGPIO_059 1>;
        ircut_b_gpio = <&gpio1 0xffff 1>;
        irled_gpio = <&gpio1 XGPIO_026 1>;
        whiteled_gpio = <&gpio1 0xffff 0>;
        isp_cfg_file = "sensorid:2336,/etc/isp.conf";
    };

    dev1_attr{
        vi_config_file = "/etc/config/vi_config_2.bin";
        //main chn info
        main_channel_width = <1920>;
        main_channel_height = <1080>;
        main_venc_mode = <1>;/*0:encode frame in user layer, 1:encode frame in kernel layer;*/
        main_chn_mode = <1>;/*0->fream, 1->slice*/
        main_chn_buf = <4>;/*fream:yuv buffer,  slice:slice num*/

        //sub chn info
        sub_channel_width = <640>;
        sub_channel_height = <360>;
        sub_venc_mode = <1>;/*0:encode frame in user layer, 1:encode frame in kernel layer;*/
        sub_chn_mode = <0>;/*0->fream, only frame*/
        sub_chn_buf = <2>;/*fream:yuv buffer*/

        //thd chn info
        third_channel_width = <320>;
        third_channel_height = <180>;
        thd_encode_mode = <1>;/*0:encode frame in user layer, 1:encode frame in kernel layer;*/
        thd_chn_mode = <0>;/*0->fream, only frame*/
        thd_chn_buf = <2>;/*fream:yuv buffer*/

        crop_left = <0>;
        crop_top = <0>;
        crop_width = <0>;
        crop_height = <0>;

        //main chn crop info
        main_crop_left = <0>;
        main_crop_top = <0>;
        main_crop_width = <0>;
        main_crop_height = <0>;

        //sub chn crop info
        sub_crop_left = <0>;
        sub_crop_top = <0>;
        sub_crop_width = <0>;
        sub_crop_height = <0>;

        //thd chn crop info
        thd_crop_left = <0>;
        thd_crop_top = <0>;
        thd_crop_width = <0>;
        thd_crop_height = <0>;

        day_night_mode_select = <0>; /* 0:irfeed light; 1: white light; 2: always day mode with light off;  3: always night mode with l
        ight on; 4: always day mode with light on;*/
        ircut_a_gpio = <&gpio1 XGPIO_059 1>;
        ircut_b_gpio = <&gpio1 0xffff 1>;
        irled_gpio = <&gpio1 XGPIO_026 1>;
        whiteled_gpio = <&gpio1 0xffff 0>;
        isp_cfg_file = "sensorid:2336,/etc/isp.conf";
    };
};
&vi0{
    clocks =
        /* isp & vpp &vin */
        <&factor_pll3_clk PLL3_FACTOR_ISP>,
        <&factor_pll3_clk PLL3_FACTOR_PP>,
        <&factor_pll3_clk PLL3_FACTOR_VICAP>,
        <&factor_pll3_clk PLL3_FACTOR_ISS>,

        /* sclk */
        <&factor_osc24 OSC24_FACTOR_CSI0_SCLK>,
        //<&factor_osc24 OSC24_FACTOR_CSI1_SCLK>,

        /* mipi dphy cfgclk */
        <&factor_pll3_clk PLL3_FACTOR_MIPI_DPHY>;

    clock-names =
        /* isp & vpp &vin */
        "isp_clk",
        "vpp_clk",
        "vin_clk",
        "iss_clk",

        /* sclk */
        "csi0_sclk",
        //"csi1_sclk",

        /* mipi dphy cfgclk */
        "mipi_dphy_cfgclk";

    pinctrl-names =
        "mipi0_4lane",
        "mipi0_3lane",
        "mipi0_2lane",
        "mipi0_1lane",
        "csi0_sclk";
        //"csi1_sclk";
    pinctrl-0 = <&mipi0_4lane_pins>;
    pinctrl-1 = <&mipi0_3lane_pins>;
    pinctrl-2 = <&mipi0_2lane_pins>;
    pinctrl-3 = <&mipi0_1lane_pins>;
    pinctrl-4 = <&csi0_sclk_pin>;
    //pinctrl-5 = <&csi1_sclk_pin>;

	/* Vega 4-lane mux, same as ov8856.sh MIPI_LANES_SWAP=0x58D10:
	 * L0=D0 L1=D1 L2=D2 L3=D3 L4=C0 L5=C1.
	 */
	csi_mipi_lane_swap = <
		SENSOR_D0	//L0
		SENSOR_D1	//L1
		SENSOR_D2	//L2
		SENSOR_D3	//L3
		SENSOR_C0	//L4
		SENSOR_C1	//L5
		>;//MIPI_RX_L0~5.

	csi_mipi_dndp_swap = <
		MIPI_DNDP_NOSWAP	//L0
		MIPI_DNDP_NOSWAP	//L1
		MIPI_DNDP_NOSWAP	//L2
		MIPI_DNDP_NOSWAP	//L3
		MIPI_DNDP_NOSWAP	//L4
		MIPI_DNDP_NOSWAP	//L5
	>;//MIPI_RX_L0~5. 0: noswap; others: swap

    status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0>;

			vi_0_0: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&sensor0_0>;
			};
			/*
			 * AF VCM media link (required for vcm_fp5510 v4l2_async subdev).
			 * Userspace AF: /dev/v4l-subdev* FOCUS_ABSOLUTE after async bind.
			 */
			vi_0_1: endpoint@1 {
				reg = <1>;
				vcm-ep;
				remote-endpoint = <&vcm0_1>;
			};
		};
#if 0
		port@1 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <1>;

			vi_1_0: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&sensor1_0>;
			};
		};
#endif
	};
};

&isp {
    status = "okay";
};

&vicap {
#if 0
    pinctrl-0 = <&pwm_csi_pins>;
    pinctrl-names = "pwm_csi";
#endif
    status = "okay";
