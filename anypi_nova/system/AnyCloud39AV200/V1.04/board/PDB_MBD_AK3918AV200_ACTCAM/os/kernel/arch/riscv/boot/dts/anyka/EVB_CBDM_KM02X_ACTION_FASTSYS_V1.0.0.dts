                        (SLEW_EN|DRIVE_SEL0)
                        (SLEW_EN|DRIVE_SEL0)
                        (SLEW_EN|DRIVE_SEL0)
                        (SLEW_EN|DRIVE_SEL0) >;
	};
	lcd_rgb_pins_sleep: lcd_rgb_pins_sleep {
		anyka,pins = <
