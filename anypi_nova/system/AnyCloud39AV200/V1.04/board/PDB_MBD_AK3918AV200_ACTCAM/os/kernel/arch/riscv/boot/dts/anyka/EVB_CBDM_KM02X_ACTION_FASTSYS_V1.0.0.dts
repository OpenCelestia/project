&mmc1 {
    bus-width = <0x4>;
    max-frequency = <25000000>;
    cap-sd-highspeed;
    non-removable;
    pinctrl-names = "default","idle";
    pinctrl-0 = <&mci1_pins>;
    pinctrl-1 = <&mci1_idle_pins>;
    status = "okay"; 
};

