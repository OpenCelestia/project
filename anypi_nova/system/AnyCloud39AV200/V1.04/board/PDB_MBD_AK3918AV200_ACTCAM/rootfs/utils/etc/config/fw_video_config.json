    "streams": [
        {
            "name": "video_main",
            "role": "main",
            "capabilities": ["h264_encode", "rtsp", "storage", "osd_main"],
            "_comment_cirbuf": "8MP I-frames at the recording bitrate are often 0.5–1MB; 2MB cirbuf underruns and looks 花. 4MB holds an IDR plus several P frames.",
            "cirbuf_size": 4194304,
            "splice_format": 0,
            "pixel_format": 32,
            "_comment_fps": "Keep 8MP; AV200 VENC budget ~3072x2048@30 (libmpi FormateFramerate). 3264x2448@30 exceeds → 'set venc fps fail, Encoder limit reached'. Max≈23fps; use the sensor max_fps (20).",
            "fps": 20,
            "channel_group_id": 0,
            "codec_config": {
                "codec_mode": 0,
                "profile": 2,
                "_comment_level": "H.264 High profile, Level 5.1 (ak_venc.h=51) for 3264x2448. High profile is the recording quality path; Level error is separate from the Encoder-limit fps check",
                "level": 51
            },
            "rc_config": {
                "avc": {
                    "rc_mode": 1,
                    "vbr": {
                        "_comment_bitrate": "8192kbps High. min_qp 18 ignored the cap and frames grew to ~390KB, so 8MP encode plus the card write held 12.5fps. QP 28–45 and change_pos 50 keep the average near 8192kbps so the sensor's 20fps can be stored.",
                        "max_bitrate": 8192,
                        "buffer_size": 8192,
                        "max_qp": 45,
                        "min_qp": 28,
                        "change_pos": 50
                    }
                }
            },
            "gop_config": {
                "_comment_gop": "gop=60@20fps ≈3s between IDR; packet loss lasts too long. gop=20 ≈1s recovery.",
                "gop_len": 20
            }
        },
        {
            "name": "video_preview",
            "role": "preview",
            "capabilities": ["h264_encode", "ui_preview", "broadcast_consumer", "settings_small_window"],
            "cirbuf_size": 1024000,
            "splice_format": 0,
            "pixel_format": 32,
            "fps": 20,
            "channel_group_id": 1,
            "codec_config": {
                "codec_mode": 3,
                "profile": 0,
                "level": 30
            },
            "rc_config": {
                "avc": {
                    "rc_mode": 1,
                    "vbr": {
                        "max_bitrate": 2048,
                        "buffer_size": 4096,
                        "max_qp": 48,
                        "min_qp": 20,
                        "change_pos": 50
                    }
                }
            },
            "gop_config": {
                "gop_len": 60
            }
        },
        {
