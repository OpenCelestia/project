"app_stream_usage": {
    "ipc_camera": {
        "roles_used": ["main", "preview", "ai"],
        "multimedia_set_camera_ai_enabled": true,
        "stream_reg_client": ["preview"],
        "notes": "预览走 broadcast；AI 分析走 ai 路；main 可供 RTSP/录像"
    },
    "camera_app": {
        "roles_used": ["preview", "main", "picture", "picture_bg", "preview_bg"],
        "multimedia_set_camera_ai_enabled": false,
        "stream_reg_client": ["preview优先", "main回退"],
        "notes": "预览 NV12；拍照保存主 JPEG，并在文件末尾附 picture_bg 子 JPEG"
    },
    "settings_lv_video_ctrl": {
        "roles_used": ["preview"],
        "multimedia_set_camera_ai_enabled": false,
        "stream_reg_client": ["preview"],
