{
/* App dashcam video layout (installed as /etc/config/app_dashcam_config.json).
 * Framework default remains fw_video_config.json.
 *   main 1920x1080 H.264 slice(num_slices=2) 25fps -> local record
 *   sub  1024x576  H.264 frame(num_slices=1) 25fps -> RTSP (vs1)
 *   crop 2560x1440 = 16:9 center crop from 2560x1920 (4:3) sensor.
 *
 * Notes:
 * - role is "sub" (not "preview"): "preview" is reserved for LCD NV12 in camera app.
 * - main uses SLICE_MODE (num_slices=2): VI frame_depth carries slice count, not
 *   max_buffers. Sub stays FRAME_MODE. Watch for CHN[0] select timeout under dual encode.
 * - RTSP-only (no record client) still needs main VI keepalive in framework so
 *   CHN1 can produce frames; main VENC stays off until local record starts. */
    "channels": [
        {
            "group_id": 0,
            "config": [
                {
                    "device_id": 0,
                    "width": 1920,
                    "height": 1080,
                    "max_buffers": 2,
                    "rotation": 0,
                    "mirror_enabled": 0,
                    "flip_enabled": 0,
                    "num_slices": 1,
                    "crop": [ 0, 240, 2560, 1440 ]
                }
            ]
        },
        {
            "group_id": 1,
            "config": [
                {
                    "device_id": 0,
                    "width": 1024,
                    "height": 576,
                    "max_buffers": 2,
                    "rotation": 0,
                    "mirror_enabled": 0,
                    "flip_enabled": 0,
                    "num_slices": 1,
                    "crop": [ 0, 240, 2560, 1440 ]
                }
            ]
        }
    ],
    "streams": [
        {
            "name": "video_main",
            "role": "main",
            "capabilities": ["h264_encode", "storage", "osd_main"],
            "cirbuf_size": 2048000,
            "splice_format": 0,
            "pixel_format": 32,
            "fps": 25,
            "channel_group_id": 0,
            "codec_config": {
                "codec_mode": 0,
                "profile": 0,
                "level": 40
            },
            "rc_config": {
                "avc": {
                    "rc_mode": 1,
                    "vbr": {
                        "max_bitrate": 4096,
                        "buffer_size": 4096,
                        "max_qp": 40,
                        "min_qp": 28,
                        "change_pos": 75
                    }
                }
            },
            "gop_config": {
                "gop_len": 40
            }
        },
        {
            "name": "video_sub",
            "role": "sub",
            "capabilities": ["h264_encode", "live_stream", "broadcast_consumer"],
            "cirbuf_size": 1024000,
            "splice_format": 0,
            "pixel_format": 32,
            "fps": 25,
            "channel_group_id": 1,
            "codec_config": {
                "codec_mode": 0,
                "profile": 0,
                "level": 40
            },
            "rc_config": {
                "avc": {
                    "rc_mode": 1,
                    "vbr": {
                        "max_bitrate": 2048,
                        "buffer_size": 2048,
                        "max_qp": 40,
                        "min_qp": 28,
                        "change_pos": 75
                    }
                }
            },
            "gop_config": {
                "gop_len": 40
            }
        }
    ]
}
