ifeq ($(CONFIG_OS_NAME),aos)
# Static user image: app_main objects only; ipc_cam and the rest archive to .a.
CONFIG_APP_MAIN_OBJECTS_ONLY = y
BUILD_SHARED = n
# compat must be the first -I so <unistd.h> / <pthread.h> / <sys/ioctl.h> hit the
# Sky39AV130 POSIX additions (platform/include/alios/compat) before the SDK
# external headers and the toolchain libc.
CORE_COMPAT_INC := $(abspath $(dir $(PROJECT_CONFIG_FILE))system/Sky39AV130/V1.01/platform/include/alios/compat)
CFLAGS := -I$(CORE_COMPAT_INC) $(filter-out -I$(CORE_COMPAT_INC),$(CFLAGS))
CFLAGS += -DKERNEL_AOS
# USB WiFi enumerate settle, consumed only by hardware/network/wifi uwlan HAL.
CFLAGS += -DCONFIG_HW_WIFI_ENUM_DELAY_MS=1200
# ak_vpss_struct.h / ak_common_audio.h select AV130 layouts from this macro.
CFLAGS += -D__CHIP_AK3918AV130_SERIES
CFLAGS += -I$(abspath $(dir $(PROJECT_CONFIG_FILE))../../system/Sky39AV130/V1.01/platform/include)
CFLAGS += -I$(abspath $(dir $(PROJECT_CONFIG_FILE))../../system/Sky39AV130/V1.01/platform/include/alios/internal)
LDFLAGS += -L$(ARM_LIBC_PATH) -L$(ARM_LIBGCC_PATH)
LDFLAGS += -nostdlib -nostartfiles -static
LDFLAGS += -mcpu=arm926ej-s -mfloat-abi=soft -mlong-calls
LDFLAGS += -Wl,--gc-sections
LDFLAGS += -Wl,--unresolved-symbols=ignore-all
LDFLAGS += -Wl,-e,main
# app_main: arm-none-eabi has no -rdynamic; use uClibc-style link group (see application/app_main/Makefile).
override APP_MAIN_IS_ARM_UCLIBC := 1
override APP_MAIN_UCLIBC_LD_PRE = -Wl,-Map,$(BUILD_DIR)/$(TARGET).map -Wl,--gc-sections -Wl,--as-needed
override APP_MAIN_UCLIBC_LD_POST = -lstdc++ $(APP_MAIN_GCC_LIB_FILE)
endif
