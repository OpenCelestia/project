&ethernet {
    pinctrl-names = "default";
    pinctrl-0 = <&ethernet_rmii_pins &ethernet_rst_pins>;
    reset-gpios = <&gpio0 XGPIO_019 1>;
    phy-address = <1>;
    status = "okay";
};
&lcdc {
    pinctrl-names = "default","8bit-mpu","16bit-mpu","sleep";
    pinctrl-0 = <&lcd_rgb_pins &lcd_reset_pins &lcd_power_pins &lcd_backlight_pins>;
    pinctrl-1 = <&lcd_8bit_mpu_pins  &lcd_reset_pins &lcd_power_pins  &lcd_backlight_pins>;
    pinctrl-2 = <&lcd_16bit_mpu_pins  &lcd_reset_pins &lcd_power_pins  &lcd_backlight_pins>;
    pinctrl-2 = <&lcd_rgb_pins_sleep &lcd_reset_pins &lcd_power_pins &lcd_backlight_pins>;
    reset-pins = <&gpio0 27 GPIO_ACTIVE_LOW>;
    pwr-gpio = <&gpio0 29 GPIO_ACTIVE_HIGH>;
    backlight-gpio = <&gpio0 28 GPIO_ACTIVE_HIGH>;
    //set to resolution ratio
    lcd-logo-width = <1024>; //note that need set equal to panel-width at present
    lcd-logo-height = <600>;//note that need set equal to panel-height at present
    //[fmt1:fmt0] 00 16bits input(RGB565 or BGR565)
    //[fmt1:fmt0] 01 24bits input(RGB888 or BGR888)
    //[fmt1:fmt0] 10 or 11 32bits input(ARGB888 ABGR888 RGBA888 BGRA888)
    lcd-logo-fmt0 = <1>;
    lcd-logo-fmt1 = <0>;
    lcd-logo-rgb-seq = <1>; //0 for BGR, 1 for RGB
    lcd-fb-type = <1>; //0:single buffer; 1:double buffer
    status = "okay";
};
&ipu {
    clock-frequency = <450000000>;
    status = "okay";
};
&encrypt {
    status = "okay";
};
&fastspi {
    pinctrl-names = "default";
    //pinctrl-0 = <&spiflash_pins &spi_nand_flash_cs_pins>;
    pinctrl-0 = <&spiflash_pins>;
    spi-bus-frequency = <100000000>;
    /*
     * cap-spi-highspeed;
     * if defined, means high speed controller(Maximum 100M/s);
     * if not, means normal speed controller(below 50M/s)
     */
    cap-spi-highspeed;
    status = "okay";
};
&watchdog0 {
    status = "okay";
};
&watchdog1 {
    status = "okay";
};
// nor-flash
&spif0 {
    /* spi flash data bus width:
    ** 1 means 1 wire mode.
    ** 2 means 2 wire mode
    ** 4 means 4 wire mode.
    ** default: 4 wire mode.
    **/
    bus-width = <4>;
    status = "okay";
};
