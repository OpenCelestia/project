#include "ak_km02-common.dtsi"
#include "ak_km02-norflash.dtsi"
#include "ak_lcd.dtsi"
#include "anycloud_ak3918av200_pinctrl.dtsi"
#define RESERVED_NPU_COMMNC_BASE      0x41400000
#define RESERVED_NPU_COMMNC_SIZE          0x8000 // 32KB
#define RESERVED_NPU_RUN_BASE         0x41408000
#define RESERVED_NPU_RUN_SIZE          0x2000000 // 16MB
#define RESERVED_ION_BASE             0x43408000
#define RESERVED_ION_SIZE              0x7000000 // 112MB
#define RESERVED_CMA_BASE             0x4a408000
#define RESERVED_CMA_SIZE               0x400000 // 4MB
//#define AK_PWR_CONSUMPTION_TEST
/* Clock frequency (in Hz) of the PCB crystal for rtcclk */
#define RTCCLK_FREQ		1000000
/ {
	#address-cells = <2>;
	#size-cells = <2>;
	model = "EVB_CBDM_KM02X_V1.0.0 board";
	compatible = "sifive,hifive-unleashed-a00", "sifive,fu540-c000";
	chosen {
		stdout-path = "serial0";
		bootargs = "console=ttySAK0,115200n8 root=/dev/mtdblock7 rootfstype=squashfs init=/sbin/init mtdparts=spi0.0:128K@0x0(SPL),128K@0x20000(OPENSBI),4K@0x40000(ENV),4K@0x41000(ENVBK),64K@0x42000(DTB),4436K@0x52000(KERNEL),300K@0x4a7000(LOGO),4096K@0x4f2000(ROOTFS),1024K@0x8f2000(CONFIG),22584K@0x9f2000(APP) mem=256M";
	};
	cpus {
		timebase-frequency = <RTCCLK_FREQ>;
	};
	memory@40000000 {
		device_type = "memory";
		reg =  <0x0 0x40000000 0x0 0x10000000>; /* 256M DDR Memory*/
	};
	soc {
	};
	hfclk: hfclk {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <33333333>;
		clock-output-names = "hfclk";
	};
	rtcclk: rtcclk {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <RTCCLK_FREQ>;
		clock-output-names = "rtcclk";
	};
	reserved-memory {
        #address-cells = <2>;
        #size-cells = <2>;
        ranges;
        npu_commnc_reserved: npu_commnc_reserved@RESERVED_NPU_COMMNC_BASE {
	        size = <RESERVED_NPU_COMMNC_SIZE>;
	        reg = <0x0 RESERVED_NPU_COMMNC_BASE 0x0 RESERVED_NPU_COMMNC_SIZE>;
	        status = "okay";
	    };
        npu_run_reserved: npu_run_reserved@RESERVED_NPU_RUN_BASE {
	        size = <RESERVED_NPU_RUN_SIZE>;
	        reg = <0x0 RESERVED_NPU_RUN_BASE 0x0 RESERVED_NPU_RUN_SIZE>;
	        status = "okay";
	    };
        carveout_reserved: carveout_reserved@RESERVED_ION_BASE {
            // compatible = "shared-dma-pool";
            // linux,cma-default;
            // reusable;
            size = <RESERVED_ION_SIZE>;
            reg = <0x0 RESERVED_ION_BASE 0x0 RESERVED_ION_SIZE>;
            status = "okay";
        };
        cma_reserved: cma_reserved@RESERVED_CMA_BASE {
	        size = <RESERVED_CMA_SIZE>;
	        reg = <0x0 RESERVED_CMA_BASE 0x0 RESERVED_CMA_SIZE>;
	        status = "okay";
	    };
        ramdisk_reserved: ramdisk_reserved@RESERVED_ION_BASE {
            /*compatible = "shared-dma-pool";*/
            /*linux,cma-default;*/
            /*reusable;*/
            size = <RESERVED_ION_SIZE>;
            reg = <0x0 RESERVED_ION_BASE 0x0 RESERVED_ION_SIZE>;
            status = "okay";
        };
	};
	ion {
		compatible = "anyka,ak3918av200-ion-reserve";
		#address-cells = <2>;
		#size-cells = <2>;
		memory-region = <&carveout_reserved>;
		ranges;
		ion_carveout_heap: ion_carveout_heap {
			base-address = <0x0 RESERVED_ION_BASE>;
			size = <0x0 RESERVED_ION_SIZE>;
			status = "okay";
		};
	};
	ramdisk:ramdisk@00000000{
		compatible = "anyka,ak3918av200-ramdisk";
		memory-region = <&ramdisk_reserved>;
		status = "okay";
	};
};
&pinctrl {
    //for uboot supports lcd display ,kernel don't reset GPIO clk domain
    no-reset-gpio-clk;
	/**
	* "anyka,function": func index, please refer to dt-bindings/pinctrl/ak3918av200_pinctrl.h
	* "anyka,pull": configuration of the pins
	* Driving selector:
	* 	GPIO[54:35]: only select DRIVE_SEL0~DRIVE_SEL3
	*	GPIO[54:35]: select DRIVE_SEL0~DRIVE_SEL7
	* Delay config:
	*	DELAY(x), x is delay time, level1 corresponds to 10ps
	*/
	ethernet_rmii_pins: ethernet_rmii_pins {
		anyka,pins = <	XGPIO_006
						XGPIO_002
						XGPIO_003
						XGPIO_000
						XGPIO_001
						XGPIO_009
						XGPIO_008
						XGPIO_007
						XGPIO_005
						XGPIO_004>;
		anyka,function = <	XGPIO_006_FUNC_RMII_OPCLK
							XGPIO_002_FUNC_RMII_RXER
							XGPIO_003_FUNC_RMII_RXDV
							XGPIO_000_FUNC_RMII_MDIO
							XGPIO_001_FUNC_RMII_MDC
							XGPIO_009_FUNC_RMII_TEEN
							XGPIO_008_FUNC_RMII_TXD1
							XGPIO_007_FUNC_RMII_TXD0
							XGPIO_005_FUNC_RMII_RXD1
							XGPIO_004_FUNC_RMII_RXD0>;
		anyka,pull = <	(INPUT_EN|SLEW_EN|DRIVE_SEL0)
						(INPUT_EN|SLEW_EN|PULL_DOWN|PULL_DOWN_EN|DRIVE_SEL0)
						(INPUT_EN|SLEW_EN|PULL_DOWN|PULL_DOWN_EN|DRIVE_SEL0)
						(INPUT_EN|SLEW_EN|PULL_UP|PULL_UP_EN|DRIVE_SEL0)
						(INPUT_EN|SLEW_EN|PULL_DOWN|PULL_DOWN_EN|DRIVE_SEL0)
						(INPUT_EN|SLEW_EN|PULL_DOWN|PULL_DOWN_EN|DRIVE_SEL0)
						(INPUT_EN|PULL_DOWN|PULL_DOWN_EN|DRIVE_SEL0)
						(INPUT_EN|PULL_DOWN|PULL_DOWN_EN|DRIVE_SEL0)
						(INPUT_EN|SLEW_EN|PULL_DOWN|PULL_DOWN_EN|DRIVE_SEL0)
						(INPUT_EN|SLEW_EN|PULL_DOWN|PULL_DOWN_EN|DRIVE_SEL0)>;
	};
	ethernet_rst_pins: ethernet_rst_pins {
		anyka,pins = <XGPIO_019>;
		anyka,function = <XGPIO_019_FUNC_GPIO19>;
		anyka,pull = <(PULL_UP|INPUT_EN|PULL_UP_EN)>;
	};
	mci1_pins: mci1_pins {
		anyka,pins = <XGPIO_027
						XGPIO_028
						XGPIO_029
						XGPIO_030
						XGPIO_031
						XGPIO_032>;
		anyka,function = <XGPIO_027_FUNC_SDIO0_DATA1
							XGPIO_028_FUNC_SDIO0_DATA0
							XGPIO_029_FUNC_SDIO0_CLK
							XGPIO_030_FUNC_SDIO0_CMD
							XGPIO_031_FUNC_SDIO0_DATA3
							XGPIO_032_FUNC_SDIO0_DATA2>;
		anyka,pull = <(INPUT_EN | PULL_UP | PULL_UP_EN)
						(INPUT_EN  | PULL_UP | PULL_UP_EN)
						(INPUT_EN | PULL_UP | PULL_UP_EN)
						(INPUT_EN | PULL_UP | PULL_UP_EN)
						(INPUT_EN | PULL_UP | PULL_UP_EN)
						(INPUT_EN | PULL_UP | PULL_UP_EN)>;
	};
	/*
	   when not use tf card, set to idle state,
	   to protect tf card and extend it's life.
	*/
	mci1_idle_pins: mci1_idle_pins {
		anyka,pins = <XGPIO_027
						XGPIO_028
						XGPIO_029
						XGPIO_030
						XGPIO_031
						XGPIO_032>;
		anyka,function = <XGPIO_027_FUNC_GPIO27
							XGPIO_028_FUNC_GPIO28
							XGPIO_029_FUNC_GPIO29
							XGPIO_030_FUNC_GPIO30
							XGPIO_031_FUNC_GPIO31
							XGPIO_032_FUNC_GPIO32>;
		anyka,pull = <0x0>;
	};
	tf_det_pins: tf_det_pins {
		anyka,pins = <XGPIO_055>;
		anyka,function = <XGPIO_055_FUNC_GPIO55>;
		anyka,pull = <(DIR_EN | DIR_INPUT | INPUT_EN | SLEW_EN | PULL_UP | PULL_UP_EN)>;
	};
	tf_en_pins: tf_en_pins {
		anyka,pins = <XGPIO_017>;
		anyka,function = <XGPIO_017_FUNC_GPIO17>;
		anyka,pull = <(DIR_EN | DIR_OUTPUT | OUTPUT_EN | SLEW_EN | PULL_UP | PULL_UP_EN | OUT_LOW)>;
	};
	/*
	   when not use tf card, set to idle state, the pin set to gpio function except mclk pin.
	   to protect tf card, extend it's life.
	*/
	mci1_idle_pins_clk: mci1_idle_pins_clk {
		anyka,pins = <XGPIO_027
						XGPIO_028
						XGPIO_029
						XGPIO_030
						XGPIO_031
						XGPIO_032>;
		anyka,function = <XGPIO_027_FUNC_GPIO27
							XGPIO_028_FUNC_GPIO28
							XGPIO_029_FUNC_SDIO0_CLK
							XGPIO_030_FUNC_GPIO30
							XGPIO_031_FUNC_GPIO31
							XGPIO_032_FUNC_GPIO32>;
		anyka,pull = <	(PULL_DOWN | PULL_DOWN_EN)
						(PULL_DOWN | PULL_DOWN_EN)
						(DIR_EN | INPUT_EN | PULL_UP | PULL_UP_EN) /* clk */
						(PULL_DOWN | PULL_DOWN_EN)
						(PULL_DOWN | PULL_DOWN_EN)
						(PULL_DOWN | PULL_DOWN_EN) >;
	};
	mci1_pins_d3_detect_mode: mci1_pins_d3_detect_mode {
		anyka,pins = <XGPIO_027
						XGPIO_028
						XGPIO_029
						XGPIO_030
						XGPIO_031
						XGPIO_032>;
		anyka,function = <XGPIO_027_FUNC_SDIO0_DATA1
							XGPIO_028_FUNC_SDIO0_DATA0
							XGPIO_029_FUNC_SDIO0_CLK
							XGPIO_030_FUNC_SDIO0_CMD
							XGPIO_031_FUNC_SDIO0_DATA3
							XGPIO_032_FUNC_SDIO0_DATA2>;
		anyka,pull = <	(INPUT_EN  | PULL_UP | PULL_UP_EN)
						(INPUT_EN  | PULL_UP | PULL_UP_EN)
						(INPUT_EN  | PULL_UP | PULL_UP_EN)
						(INPUT_EN  | PULL_UP | PULL_UP_EN)
						(INPUT_EN) /* disable pull down and pull up */
						(INPUT_EN  | PULL_UP | PULL_UP_EN)
						>;
	};
	/*
	   when not use tf card, set to idle state, the pin set to gpio function except dat3 pin.
	   to protect tf card, extend it's life.
	*/
	mci1_idle_pins_d3: mci1_idle_pins_d3 {
		anyka,pins = <XGPIO_027
						XGPIO_028
						XGPIO_029
						XGPIO_030
						XGPIO_031
						XGPIO_032>;
		anyka,function = <XGPIO_027_FUNC_GPIO27
							XGPIO_028_FUNC_GPIO28
							XGPIO_029_FUNC_GPIO29
							XGPIO_030_FUNC_GPIO30
							XGPIO_031_FUNC_SDIO0_DATA3
							XGPIO_032_FUNC_GPIO32>;
		anyka,pull = <	(PULL_DOWN | PULL_DOWN_EN)
						(PULL_DOWN | PULL_DOWN_EN)
						(PULL_DOWN | PULL_DOWN_EN)
						(PULL_DOWN | PULL_DOWN_EN)
						(INPUT_EN)	/* disable pull down and pull up */
						(PULL_DOWN | PULL_DOWN_EN) >;
	};
	mci2_pins: mci2_pins {
		anyka,pins = <XGPIO_079
					 XGPIO_080
					 XGPIO_081
					 XGPIO_082
					 XGPIO_083
					 XGPIO_084>;
		anyka,function = <	XGPIO_079_FUNC_SDIO1_DATA1
						XGPIO_080_FUNC_SDIO1_DATA0
						XGPIO_081_FUNC_SDIO1_CLK
						XGPIO_082_FUNC_SDIO1_CMD
						XGPIO_083_FUNC_SDIO1_DATA3
						XGPIO_084_FUNC_SDIO1_DATA2>;
		anyka,pull = <(INPUT_EN | PULL_UP | PULL_UP_EN)
						(INPUT_EN  | PULL_UP | PULL_UP_EN)
						(INPUT_EN | PULL_UP | PULL_UP_EN)
						(INPUT_EN | PULL_UP | PULL_UP_EN)
						(INPUT_EN | PULL_UP | PULL_UP_EN)
						(INPUT_EN | PULL_UP | PULL_UP_EN)>;
	};
	lcd_rgb_pins: lcd_rgb_pins {
		anyka,pins = <
                     XGPIO_057  //LCD_VOGATE
                     XGPIO_058  //LCD_VOVSYNC
                     XGPIO_059  //LCD_VOHSYNC
                     XGPIO_060  //LCD_PCLK
                     XGPIO_061  //LCD_D0
					 XGPIO_062   //LCD_D1
					 XGPIO_063   //LCD_D2
					 XGPIO_064   //LCD_D3
					 XGPIO_065   //LCD_D4
					 XGPIO_066   //LCD_D5
					 XGPIO_067   //LCD_D6
                     XGPIO_068   //LCD_D7
                     XGPIO_069   //LCD_D8
					 XGPIO_070   //LCD_D9
					 XGPIO_071   //LCD_D10
					 XGPIO_072   //LCD_D11
					 XGPIO_073   //LCD_D12
					 XGPIO_074   //LCD_D13
					 XGPIO_075   //LCD_D14
					 XGPIO_076   //LCD_D15
					 XGPIO_077   //LCD_D16
					 XGPIO_078   //LCD_D17
					 XGPIO_079   //LCD_D18
					 XGPIO_080   //LCD_D19
					 XGPIO_081   //LCD_D20
					 XGPIO_082   //LCD_D21
					 XGPIO_083   //LCD_D22
					 XGPIO_084 >;//LCD_D23
		anyka,function = <	
                        XGPIO_057_FUNC_RGB_VOGATE
						XGPIO_058_FUNC_RGB_VOVSYNC
						XGPIO_059_FUNC_RGB_VOHSYNC
						XGPIO_060_FUNC_RGB_VOPCLK
                        XGPIO_061_FUNC_RGB_D0
						XGPIO_062_FUNC_RGB_D1
						XGPIO_063_FUNC_RGB_D2
						XGPIO_064_FUNC_RGB_D3
						XGPIO_065_FUNC_RGB_D4
						XGPIO_066_FUNC_RGB_D5
						XGPIO_067_FUNC_RGB_D6
						XGPIO_068_FUNC_RGB_D7
						XGPIO_069_FUNC_RGB_D8
						XGPIO_070_FUNC_RGB_D9
						XGPIO_071_FUNC_RGB_D10
						XGPIO_072_FUNC_RGB_D11
						XGPIO_073_FUNC_RGB_D12
						XGPIO_074_FUNC_RGB_D13
						XGPIO_075_FUNC_RGB_D14
						XGPIO_076_FUNC_RGB_D15
						XGPIO_077_FUNC_RGB_D16
						XGPIO_078_FUNC_RGB_D17
						XGPIO_079_FUNC_RGB_D18
						XGPIO_080_FUNC_RGB_D19
						XGPIO_081_FUNC_RGB_D20
						XGPIO_082_FUNC_RGB_D21
						XGPIO_083_FUNC_RGB_D22
						XGPIO_084_FUNC_RGB_D23 >;
		anyka,pull = <  (SLEW_EN|PULL_UP|PUPD_EN|DRIVE_SEL4)
                        (SLEW_EN|PULL_UP|PUPD_EN|DRIVE_SEL4)
                        (SLEW_EN|PULL_UP|PUPD_EN|DRIVE_SEL4)
                        (SLEW_EN|PULL_UP|PUPD_EN|DRIVE_SEL6)
                        (SLEW_EN|PULL_UP|PUPD_EN|DRIVE_SEL4)
                        (SLEW_EN|PULL_UP|PUPD_EN|DRIVE_SEL4)
                        (SLEW_EN|PULL_UP|PUPD_EN|DRIVE_SEL4)
                        (SLEW_EN|PULL_UP|PUPD_EN|DRIVE_SEL4)
                        (SLEW_EN|PULL_UP|PUPD_EN|DRIVE_SEL4)
                        (SLEW_EN|PULL_UP|PUPD_EN|DRIVE_SEL4)
                        (SLEW_EN|PULL_UP|PUPD_EN|DRIVE_SEL4)
