	lcd_rgb_pins_sleep: lcd_rgb_pins_sleep {
		anyka,pins = <
                     XGPIO_057  //LCD_VOGATE
                     XGPIO_058  //LCD_VOVSYNC
                     XGPIO_059  //LCD_VOHSYNC
                     XGPIO_060  //LCD_PCLK
                     XGPIO_061  //LCD_D0
					 XGPIO_062   //LCD_D1
					 XGPIO_063   //LCD_D2
					 XGPIO_064   //LCD_D3
					 XGPIO_065   //LCD_D4
