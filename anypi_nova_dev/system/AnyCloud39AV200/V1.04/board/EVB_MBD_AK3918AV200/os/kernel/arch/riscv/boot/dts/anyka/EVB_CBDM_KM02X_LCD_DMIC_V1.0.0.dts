    pinctrl-names = "default";
    pinctrl-0 = <&spi0_pins>;
    spi-bus-frequency = <50000000>;
    status = "disable";
    spidev0: spidev@0 {
        compatible = "rohm,dh2228fv";
        reg = <0>; // Chip select
        spi-max-frequency = <50000000>;
        status = "okay";
    };
};
