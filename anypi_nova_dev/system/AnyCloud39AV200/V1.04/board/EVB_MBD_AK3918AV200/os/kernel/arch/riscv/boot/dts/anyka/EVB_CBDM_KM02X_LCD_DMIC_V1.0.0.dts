                     XGPIO_069   //LCD_D8
					 XGPIO_070   //LCD_D9
					 XGPIO_071   //LCD_D10
					 XGPIO_072   //LCD_D11
					 XGPIO_073   //LCD_D12
					 XGPIO_074   //LCD_D13
					 XGPIO_075   //LCD_D14
					 XGPIO_076   //LCD_D15
					 XGPIO_077   //LCD_D16
					 XGPIO_078   //LCD_D17
					 XGPIO_079   //LCD_D18
					 XGPIO_080   //LCD_D19
					 XGPIO_081   //LCD_D20
					 XGPIO_082   //LCD_D21
					 XGPIO_083   //LCD_D22
					 XGPIO_084 >;//LCD_D23
		anyka,function = <	
                        XGPIO_057_FUNC_GPIO57
						XGPIO_058_FUNC_GPIO58
						XGPIO_059_FUNC_GPIO59
						XGPIO_060_FUNC_GPIO60
                        XGPIO_061_FUNC_GPIO61
						XGPIO_062_FUNC_GPIO62
						XGPIO_063_FUNC_GPIO63
						XGPIO_064_FUNC_GPIO64
						XGPIO_065_FUNC_GPIO65
						XGPIO_066_FUNC_GPIO66
						XGPIO_067_FUNC_GPIO67
						XGPIO_068_FUNC_GPIO68
						XGPIO_069_FUNC_GPIO69
						XGPIO_070_FUNC_GPIO70
						XGPIO_071_FUNC_GPIO71
						XGPIO_072_FUNC_GPIO72
						XGPIO_073_FUNC_GPIO73
						XGPIO_074_FUNC_GPIO74
						XGPIO_075_FUNC_GPIO75
						XGPIO_076_FUNC_GPIO76
						XGPIO_077_FUNC_GPIO77
						XGPIO_078_FUNC_GPIO78
						XGPIO_079_FUNC_GPIO79
						XGPIO_080_FUNC_GPIO80
						XGPIO_081_FUNC_GPIO81
						XGPIO_082_FUNC_GPIO82
						XGPIO_083_FUNC_GPIO83
						XGPIO_084_FUNC_GPIO84 >;
		anyka,pull = <0>;
	};
	lcd_reset_pins: lcd_reset_pins {
		anyka,pins = <XGPIO_027>;
		anyka,function = <XGPIO_027_FUNC_GPIO27>;
		anyka,pull = <0>;
	};
	lcd_power_pins: lcd_power_pins {
		anyka,pins = <XGPIO_029>;
		anyka,function = <XGPIO_029_FUNC_GPIO29>;
		anyka,pull = <0x0>;
	};
	lcd_backlight_pins: lcd_backlight_pins {
		anyka,pins = <XGPIO_028>;
		anyka,function = <XGPIO_028_FUNC_GPIO28>;
		anyka,pull = <0x0>;
	};
	mci2_idle_pins: mci2_idle_pins {
		anyka,pins = <	XGPIO_079
					XGPIO_080
					XGPIO_081
					XGPIO_082
					XGPIO_083
					XGPIO_084>;
		anyka,function = <	XGPIO_079_FUNC_GPIO79
							XGPIO_080_FUNC_GPIO80
							XGPIO_081_FUNC_GPIO81
							XGPIO_082_FUNC_GPIO82
							XGPIO_083_FUNC_GPIO83
							XGPIO_084_FUNC_GPIO84>;
		anyka,pull = <0x0>;
	};
	wifi_en_pins: wifi_en_pins {
		anyka,pins = <XGPIO_077>;
		anyka,function = <XGPIO_077_FUNC_GPIO77>;
		anyka,pull = <(DIR_EN | DIR_OUTPUT | OUTPUT_EN | SLEW_EN | PULL_UP | PULL_UP_EN | OUT_HIGH)>;
	};
	wifi_rst_pins: wifi_rst_pins {
		anyka,pins = <XGPIO_078>;
		anyka,function = <XGPIO_078_FUNC_GPIO78>;
		anyka,pull = <(DIR_EN | DIR_OUTPUT | OUTPUT_EN | SLEW_EN | PULL_UP | PULL_UP_EN | OUT_HIGH)>;
	};
	mipi0_4lane_pins: mipi0_4lane_pins {
		anyka,pins = <	XGPIO_041
						XGPIO_042
						XGPIO_043
						XGPIO_044
						XGPIO_045
						XGPIO_046
						XGPIO_047
						XGPIO_048
						XGPIO_049
						XGPIO_050
						XGPIO_051
						XGPIO_052 >;
		anyka,function = <	XGPIO_041_FUNC_MIPI_RX_L0P
							XGPIO_042_FUNC_MIPI_RX_L0N
							XGPIO_043_FUNC_MIPI_RX_L1P
							XGPIO_044_FUNC_MIPI_RX_L1N
							XGPIO_045_FUNC_MIPI_RX_L2P
							XGPIO_046_FUNC_MIPI_RX_L2N
							XGPIO_047_FUNC_MIPI_RX_L3P
							XGPIO_048_FUNC_MIPI_RX_L3N
							XGPIO_049_FUNC_MIPI_RX_L4P
							XGPIO_050_FUNC_MIPI_RX_L4N
							XGPIO_051_FUNC_MIPI_RX_L5P
							XGPIO_052_FUNC_MIPI_RX_L5N	>;
		anyka,pull = <0>;
	};
	mipi0_3lane_pins: mipi0_3lane_pins {
		anyka,pins = <	XGPIO_041
						XGPIO_042
						XGPIO_043
						XGPIO_044
						XGPIO_045
						XGPIO_046
						XGPIO_047
						XGPIO_048
						XGPIO_049
						XGPIO_050
						XGPIO_051
						XGPIO_052 >;
		anyka,function = <	XGPIO_041_FUNC_MIPI_RX_L0P
							XGPIO_042_FUNC_MIPI_RX_L0N
							XGPIO_043_FUNC_MIPI_RX_L1P
							XGPIO_044_FUNC_MIPI_RX_L1N
							XGPIO_045_FUNC_MIPI_RX_L2P
							XGPIO_046_FUNC_MIPI_RX_L2N
							XGPIO_047_FUNC_MIPI_RX_L3P
							XGPIO_048_FUNC_MIPI_RX_L3N
							XGPIO_049_FUNC_MIPI_RX_L4P
							XGPIO_050_FUNC_MIPI_RX_L4N
							XGPIO_051_FUNC_MIPI_RX_L5P
							XGPIO_052_FUNC_MIPI_RX_L5N	>;
		anyka,pull = <0>;
	};
	mipi0_2lane_pins: mipi0_2lane_pins {
		anyka,pins = <	XGPIO_041
						XGPIO_042
						XGPIO_043
						XGPIO_044
						XGPIO_045
						XGPIO_046 >;
		anyka,function = <	XGPIO_041_FUNC_MIPI_RX_L0P
							XGPIO_042_FUNC_MIPI_RX_L0N
							XGPIO_043_FUNC_MIPI_RX_L1P
							XGPIO_044_FUNC_MIPI_RX_L1N
							XGPIO_045_FUNC_MIPI_RX_L2P
							XGPIO_046_FUNC_MIPI_RX_L2N >;
		anyka,pull = <0>;
	};
	mipi0_1lane_pins: mipi0_1lane_pins {
		anyka,pins = <	XGPIO_041
						XGPIO_042
						XGPIO_043
						XGPIO_044
						XGPIO_045
						XGPIO_046 >;
		anyka,function = <	XGPIO_041_FUNC_MIPI_RX_L0P
							XGPIO_042_FUNC_MIPI_RX_L0N
							XGPIO_043_FUNC_MIPI_RX_L1P
							XGPIO_044_FUNC_MIPI_RX_L1N
							XGPIO_045_FUNC_MIPI_RX_L2P
							XGPIO_046_FUNC_MIPI_RX_L2N >;
		anyka,pull = <0>;
	};
	csi0_sclk_pin: csi0_sclk_pin {
		anyka,pins = <	XGPIO_037 >;
		anyka,function = <	XGPIO_037_FUNC_CSI0_SCLK >;
		anyka,pull = <0>;
	};
    
    csi1_sclk_pin: csi1_sclk_pin {
        anyka,pins = <  XGPIO_038 >;
        anyka,function = <  XGPIO_038_FUNC_CSI1_SCLK >;
        anyka,pull = <0>;
    };
    pwm_csi_pins: pwm_csi_pins {
        anyka,pins = < XGPIO_053
                        XGPIO_054 >;
        anyka,function = < XGPIO_053_FUNC_PWM_CSI0
                            XGPIO_054_FUNC_PWM_CSI1 >;
        anyka,pull = <0>;
    };
    i2c1_pins: i2c1_pins {
        anyka,pins = <XGPIO_084 XGPIO_083>;
        anyka,function = <XGPIO_084_FUNC_I2C1_SDA XGPIO_083_FUNC_I2C1_SCL>;
        anyka,pull = <(PULL_UP|INPUT_EN|SLEW_EN|HOLD_EN|DRIVE_SEL0)>;
    };
	motor0_pins: motor0_pins {
		anyka,pins = <XGPIO_027 XGPIO_028 XGPIO_029 XGPIO_030>;
		anyka,function = <0>;
		anyka,pull = <PULL_UP>;
	};
	motor1_pins: motor1_pins {
		anyka,pins = <XGPIO_021 XGPIO_022 XGPIO_023 XGPIO_024>;
		anyka,function = <0>;
		anyka,pull = <PULL_UP>;
	};
    gt9xx_pins: gt9xx_pins {
        anyka,pins = <XGPIO_026 XGPIO_090>;
        anyka,function = <XGPIO_026_FUNC_GPIO26 XGPIO_090_FUNC_GPIO90>;
        anyka,pull = <(PULL_UP|INPUT_EN|DRIVE_SEL0)>;
    };
    i2c3_pins: i2c3_pins {
        anyka,pins = <XGPIO_032 XGPIO_031>;
        anyka,function = <XGPIO_032_FUNC_I2C3_SDA XGPIO_031_FUNC_I2C3_SCL>;
        anyka,pull = <(PULL_UP|INPUT_EN|SLEW_EN|HOLD_EN|DRIVE_SEL0)>;
    };

    i2c2_pins: i2c2_pins {
        anyka,pins = <XGPIO_017 XGPIO_018>;
        anyka,function = <XGPIO_017_FUNC_I2C2_SCL XGPIO_018_FUNC_I2C2_SDA>;
        anyka,pull = <(PULL_UP|INPUT_EN|SLEW_EN|HOLD_EN|DRIVE_SEL0)>;
    };

    fts_pins: fts_pins {
        anyka,pins = <XGPIO_020 XGPIO_055>;
        anyka,function = <XGPIO_020_FUNC_GPIO20 XGPIO_055_FUNC_GPIO55>;
        anyka,pull = <(PULL_UP|INPUT_EN|DRIVE_SEL0)>;
    };
};
&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pins>;
	status = "okay";
};
&uart1 {
	status = "disable";
};
&npu {
	status = "okay";
};
&vi0{
    clocks =
        /* isp & vpp &vin */
        <&factor_pll3_clk PLL3_FACTOR_ISP>,
        <&factor_pll3_clk PLL3_FACTOR_PP>,
        <&factor_pll3_clk PLL3_FACTOR_VICAP>,
        <&factor_pll3_clk PLL3_FACTOR_ISS>,
        /* sclk */
        <&factor_osc24 OSC24_FACTOR_CSI0_SCLK>,
        <&factor_osc24 OSC24_FACTOR_CSI1_SCLK>,
        /* mipi dphy cfgclk */
        <&factor_pll3_clk PLL3_FACTOR_MIPI_DPHY>;
    clock-names =
        /* isp & vpp &vin */
        "isp_clk",
        "vpp_clk",
        "vin_clk",
        "iss_clk",
        /* sclk */
        "csi0_sclk",
        "csi1_sclk",
        /* mipi dphy cfgclk */
        "mipi_dphy_cfgclk";
    pinctrl-names =
        "mipi0_4lane",
        "mipi0_3lane",
        "mipi0_2lane",
        "mipi0_1lane",
        "csi0_sclk",
        "csi1_sclk";
    pinctrl-0 = <&mipi0_4lane_pins>;
    pinctrl-1 = <&mipi0_3lane_pins>;
    pinctrl-2 = <&mipi0_2lane_pins>;
    pinctrl-3 = <&mipi0_1lane_pins>;
    pinctrl-4 = <&csi0_sclk_pin>;
    pinctrl-5 = <&csi1_sclk_pin>;
	csi_mipi_lane_swap = <
		SENSOR_D0	//L0
		SENSOR_C0	//L1
		SENSOR_D1	//L2
		SENSOR_D2	//L3
		SENSOR_D3	//L4
		SENSOR_C1	//L5
		>;//MIPI_RX_L0~5.
	csi_mipi_dndp_swap = <
		MIPI_DNDP_NOSWAP	//L0
		MIPI_DNDP_NOSWAP	//L1
		MIPI_DNDP_NOSWAP	//L2
		MIPI_DNDP_NOSWAP	//L3
		MIPI_DNDP_NOSWAP	//L4
		MIPI_DNDP_NOSWAP	//L5
	>;//MIPI_RX_L0~5. 0: noswap; others: swap
    status = "okay";
	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@0 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0>;
			vi_0_0: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&sensor0_0>;
			};
		};
		port@1 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <1>;
			vi_1_0: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&sensor1_0>;
			};
		};
	};
};
&isp {
    status = "okay";
};
&vicap {
    pinctrl-0 = <&pwm_csi_pins>;
    pinctrl-names = "pwm_csi";
    status = "okay";
};
&pp {
    status = "okay";
};
&i2c0 {
    pinctrl-names = "default";
    pinctrl-0 = <&i2c0_pins>;
    
    clock-frequency = <312000>;
    status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
    
	sensor0: camera@0x30{
		compatible = "anyka,sensor0";
		reg = <0x30>;
		/*0xffff means the gpio is invalid*/
		reset-gpio = <&gpio1 XGPIO_039 1>;
		pwdn-gpio = <&gpio1 XGPIO_040 1>;
//		reset-gpio = <&gpio1 7 1>;
//		pwdn-gpio = <&gpio1 8 1>;
		port {
			sensor0_0: endpoint@0 {
				remote-endpoint = <&vi_0_0>;
			};
		};
	};
	sensor1: camera@0x32{
		compatible = "anyka,sensor0";
		reg = <0x32>;
		/*0xffff means the gpio is invalid*/
		reset-gpio = <&gpio1 XGPIO_039 1>;
		pwdn-gpio = <&gpio1 XGPIO_040 1>;
//		reset-gpio = <&gpio1 7 1>;
//		pwdn-gpio = <&gpio1 8 1>;
		port {
			sensor1_0: endpoint@0 {
				remote-endpoint = <&vi_1_0>;
			};
		};
	};
};
#ifdef AK_PWR_CONSUMPTION_TEST
&i2c1 {
    pinctrl-names = "default";
    pinctrl-0 = <&i2c1_pins>;
    clock-frequency = <312000>;
    status = "disable";
    ina2xx_0: ina220@0x42{
    compatible = "anyka,sensor0_ina2xx";
    reg = <0x42>;
    };
    ina2xx_1: ina220@0x4a{
    compatible = "anyka,sensor1_ina2xx";
    reg = <0x4a>;
    };
    ina2xx_2: ina220@0x40{
    compatible = "anyka,sensor2_ina2xx";
    reg = <0x40>;
    };
    ina2xx_3: ina220@0x48{
    compatible = "anyka,sensor3_ina2xx";
    reg = <0x48>;
    };
};
#else
&i2c1 {
    pinctrl-names = "default";
    pinctrl-0 = <&i2c1_pins>;
    clock-frequency = <312000>;
    status = "disable";
};
#endif
/*
  开发板的核心板引用i2c2，
  需修改硬件选择i2c
*/
&i2c2 {
    pinctrl-names = "default";
    pinctrl-0 = <&i2c2_pins>;
    clock-frequency = <400000>;
    status = "okay";

    touch-screen@38 {
        compatible = "focaltech,fts";
        reg = <0x38>;
        pinctrl-names = "default";
        pinctrl-0 = <&fts_pins>;

        focaltech,panel-type = <0x54260002>;
        focaltech,max-touch-number = <1>;
        focaltech,display-coords = <0 0 1024 600>;
        //focaltech,swap-xy;
		revert_x; 
		revert_y;
        focaltech,reset-gpio = <&gpio1 55 GPIO_ACTIVE_LOW>;
        focaltech,irq-gpio = <&gpio0 20 GPIO_ACTIVE_LOW>;

        status = "okay";
    };
};

&i2c3 {
    pinctrl-names = "default";
    pinctrl-0 = <&i2c3_pins>;
    clock-frequency = <400000>;
    status = "disable";

    touch-screen@38 {
        compatible = "focaltech,fts";
        reg = <0x38>;
        pinctrl-names = "default";
        pinctrl-0 = <&fts_pins>;
        focaltech,panel-type = <0x54260002>;
        focaltech,max-touch-number = <1>;
        focaltech,display-coords = <0 0 1024 600>;
        //focaltech,swap-xy;
        focaltech,reset-gpio = <&gpio1 55 GPIO_ACTIVE_LOW>;
        focaltech,irq-gpio = <&gpio0 30 GPIO_ACTIVE_LOW>;

/*
        focaltech,have-key;
        focaltech,key-number = <3>;
        focaltech,keys = <139 102 158>;
        focaltech,key-y-coord = <2000>;
        focaltech,key-x-coords = <200 600 800>;
*/
        status = "okay";
    };
    touch-screen@14 {
        compatible = "anyka,ak37e-i2c-touchscreen-gt911";
        reg = <0x14>;
        pinctrl-names = "default";
        pinctrl-0 = <&gt9xx_pins>;
        irq-gpio = <&gpio2 90 GPIO_ACTIVE_LOW>;
        reset-gpio = <&gpio0 26 GPIO_ACTIVE_LOW>;
        touchscreen-max-id = <16>;
        touchscreen-size-x = <1024>;
        touchscreen-size-y = <600>;
        goodix,swap-x2y = <1>;
        goodix,int-sync = <1>;
        status = "disable";
#if 0
        goodix,auto-update = <1>;
        goodix,auto-update-cfg = <1>;
#endif
        goodix,driver-send-cfg = <1>;
        goodix,cfg-group0 = [
            41 00 04 58 02 05 05 00 01 08 28 
            05 50 32 03 05 00 00 00 00 00 00
            00 00 00 00 00 8D 2D 0E 2A 2C 31
            0D 00 00 01 BA 03 24 00 00 00 00
            00 03 00 00 00 00 00 0F 41 94 D5
            02 07 00 00 04 9B 11 00 77 17 00
            5C 1F 00 48 2A 00 3B 38 00 3B 00
            00 00 00 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 00 00 00
            00 00 02 04 06 08 0A 0C 0E 10 12
            14 16 18 1A 1C FF FF FF FF FF FF
            FF FF FF FF FF FF FF FF FF FF 00
            02 04 06 08 0A 0C 0F 10 12 13 14
            16 18 1C 1D 1E 1F 20 21 22 24 26
            28 29 2A FF FF FF FF FF FF FF FF
            FF FF FF FF FF FF FF FF BB 01
        ];
    };
};
