&mmc1 {
    bus-width = <0x4>;
    max-frequency = <25000000>;
    cd_d3;
    cap-sd-highspeed;
    pinctrl-names = "default","idle";
    pinctrl-0 = <&mci1_pins_d3_detect_mode>,<&tf_en_pins>;
    pinctrl-1 = <&mci1_idle_pins_d3>; 
    power-pins = <&gpio0 XGPIO_017 1>; 
    power-inverted;
    status = "disable"; 
};
&mmc2 {
    bus-width = <0x4>;
    max-frequency = <50000000>;
    non-removable;
    cap-sd-highspeed;
    /* if support sdio, using cap-sdio-irq*/
    cap-sdio-irq;
    pinctrl-names = "default","idle";
    pinctrl-0 = <&mci2_pins>,<&wifi_en_pins>,<&wifi_rst_pins>;
    pinctrl-1 = <&mci2_idle_pins>;
    power-pins = <&gpio2 XGPIO_077 1>;   //power-pins is which wifi_en_pins describes
    rst-pins =   <&gpio2 XGPIO_078 1>;    //rst-pins is which wifi_rst_pins describes
    status = "disable"; 
};
&usb {
    status = "okay";
};
&adc_dac {
    pinctrl-names = "default";
    // only ADC:
    //   pinctrl-0 = <&speaker_en_pins>;
    // PDM or ADC + PDM
    pinctrl-0 = <&speaker_en_pins>,<&pdm_pins>;
    // pinctrl-0 = <&speaker_en_pins>;

    speak-gpios = <&gpio0 XGPIO_010 1>;
    /*
    * The level of speak-gpios votage for power on audio: 0=low, 1=high
    */
    speak-gpios-en = <1>;
    // only ADC Left MIC:
    // mic-info = <MIC_INFO_ADC_MIC0>;
    // only ADC Right MIC:
    // mic-info = <MIC_INFO_ADC_MIC1>;
    // ADC 2 MIC:
    // mic-info = <(MIC_INFO_ADC_MIC0|MIC_INFO_ADC_MIC1)>;
    // PDM 2 MIC:
    mic-info = <(MIC_INFO_PDM0|MIC_INFO_PDM1)>;
    // PDM 4 MIC:
    // mic-info = <(MIC_INFO_PDM0|MIC_INFO_PDM1|MIC_INFO_PDM2|MIC_INFO_PDM3)>;
    // mic-info = <MIC_INFO_ADC_MIC0>;
    spk-info = <SPK_INFO_DAC_HPOUT>;
    status = "okay";
    dev0 {
        snd-dev = <SND_CARD_DAC_PLAYBACK>;
        snd-type = <AK_PCM_DEV_PLAYBACK>;
    };
    dev1 {
        snd-dev = <SND_CARD_ADC_CAPTURE>;
        snd-type = <AK_PCM_DEV_CAPTURE>;
        mic_gain = <0x505>;
    };
    dev2 {
        snd-dev = <SND_CARD_DAC_LOOPBACK>;
        snd-type = <AK_PCM_DEV_LOOPBACK>;
    };
    // PDM device file
    dev3 {
        snd-dev = <SND_CARD_PDM_RECV>;
        snd-type = <AK_PCM_DEV_CAPTURE>;
    };
};
&saradc{
	pinctrl-names = "default";
	//pinctrl-0 = <&saradc_ain1_pins>;
	/* SAR ADC VREF selection
	* 0:To select AVCC 1.8V as VREF for SAR ADC.
	* 1:To select 1.6V generated from BGR as VREF for SAR ADC.
	*/
	vref-select = <0>;
	/*
	* 0:To disable BAT voltage divider.
	* 1:To enable BAT voltage divider divided by 4.
	*/
	battery-divider = <1>;
	/*
	* Sampling number
	* Read the sampling data for N times and then calculate the average value.
	* N ranges from 1 to 7.
	*/
	sampling-num = <3>;
	status = "okay";
};
&adkeys {
    /*
    * poll interval: ms
    * debounce interval: ms
    */
    interval = <120>;
    debounce_interval = <20>;
    /*
    * if pressed-input = 0, input 0 when key is pressed, else input 1.
    */
    pressed-input = <0>;
    status = "okay";
    addet0 {
        unpress_min = <0>;
        unpress_max = <1800>;
        adc_index = <1>;
        adc_channel = <0>;
        key1 {
            linux,code = <102>; /*HOME*/
            min = <0>;
            max = <50>;
        };
        key2 {
            linux,code = <103>; /*UP*/
            min = <300>;
            max = <350>;
        };
        key3 {
            linux,code = <108>; /*DOWN*/
            min = <600>;
            max = <650>;
        };
        key4 {
            linux,code = <105>; /*LEFT*/
            min = <1100>;
            max = <1200>;
        };
        key5 {
            linux,code = <106>; /*RIGHT*/
            min = <850>;
            max = <950>;
        };
        key6 {
            linux,code = <28>; /*OK*/
            min = <1400>;
            max = <1450>;
        };
        key7 {
            linux,code = <158>; /*RETURN*/
            min = <1650>;
            max = <1750>;
        };
    };
};
&gpiokeys {
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-0 = <&gpiokey_pins>;
	pinctrl-names = "default";
	status = "okay";
	config {
		label = "config_key";
		gpios = <&gpio0 XGPIO_018 GPIO_ACTIVE_HIGH>;
		linux,code = <116>;
		debounce-interval = <100>;
	};
};
&leds {
	pinctrl-names = "default";
	pinctrl-0 = <&infrared_led_pins>,<&state_led_pins>;
	status = "disable";
	ir_led {
		label = "irled";
		gpios = <&gpio0 XGPIO_020 GPIO_ACTIVE_HIGH>;
	};
	state_led {
		label = "state_led";
		gpios = <&gpio2 XGPIO_075 GPIO_ACTIVE_HIGH>;
	};
};
&motor0 {
	/*
	 * part-number: part name
	 * pwm-tbl-cw: pwm table int clkwise
	 * pwm-pins: gpio list to motor
	 * steps-one-circle: total steps one circle (360degree)
	 *
	 * total-steps:	total steps the motor can run
	 * boundary-steps: reserve some step for each boudary
	 * attach-timer: timer for the motor
	 *					NOTE: different motor attach different timer
	 *
	 * speed-step: speed in step
	 */
	pinctrl-names = "default";
	pinctrl-0 = <&motor0_pins>;
	part-number = "HZF-24BYJ48";
	pwm-tbl-cw = <0x09 0x01 0x03 0x02 0x06 0x04 0x0c 0x08>;
	pwm-pins = <XGPIO_027 XGPIO_028 XGPIO_029 XGPIO_030>;//借用了t卡的引脚，注意冲突
	steps-one-circle = <4096>;
	total-steps = <2500>;
	boundary-steps = <50>;
	attach-timer = <1>; //devmem 0x80000c8
	speed-step = <200>;
	status = "disable";
};
&motor1 {
	/*
	 * part-number: part name
	 * pwm-tbl-cw: pwm table int clkwise
	 * pwm-pins: gpio list to motor
	 * steps-one-circle: total steps one circle (360degree)
	 *
	 * total-steps:	total steps the motor can run
	 * boundary-steps: reserve some step for each boudary
	 * attach-timer: timer for the motor
	 *					NOTE: different motor attach different timer
	 *
	 * speed-step: speed in step
	 */
	pinctrl-names = "default";
	pinctrl-0 = <&motor1_pins>;
	part-number = "HZF-24BYJ48";
	pwm-tbl-cw = <0x09 0x01 0x03 0x02 0x06 0x04 0x0c 0x08>;
	pwm-pins = <XGPIO_029 XGPIO_030 XGPIO_031 XGPIO_032>;
	steps-one-circle = <4096>;
	total-steps = <600>;
	boundary-steps = <50>;
	attach-timer = <2>;
	speed-step = <200>;
	status = "disable";
};
&rtc {
	status = "okay";
};
&pwm5 {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm5_pins>;
	period-ns = <500>;
	duty-ns = <100>;
	pwm-enable = <1>;
	status = "disable";
};
&HT070GB {
    panel-pclk-rate = <50000000>;
    status = "disable";
};
&HX070WS0057BCB {
    panel-pclk-rate = <50000000>;
    status = "okay";
};
&ESHX035WQ00 {
    panel-pclk-rate = <30000000>;
    status = "disable";
};
&TFT035F014 {
    panel-pclk-rate = <30000000>;
    status = "disable";
};
&dvfs {
    attach-timer = <2>;
    status = "okay";
};