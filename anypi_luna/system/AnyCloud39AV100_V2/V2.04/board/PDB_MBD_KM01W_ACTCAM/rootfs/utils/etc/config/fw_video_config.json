/* KM01W ACTCAM (CAMERA_MAX_CHANNEL=3):
 * IMPORTANT:
 * 1) channel_group_id is the channels[] array index (must be ordered 0,1,2...).
 * 2) HAL physical channels are assigned by first-seen unique resolution order:
 *      1st new resolution → HAL ch0 / VI CHN0
 *      2nd new resolution → HAL ch1 / VI CHN1
 *      3rd new resolution → HAL ch2 / VI CHN16 (chip max 640x640)
 *    Therefore streams[] must introduce 1920 first, then 1024, then 256;
 *    otherwise 1024x576 lands on CHN16 → ak_vi_set_chn_attr_ex fails → configure -1.
 *   group 0  main/dashcam/picture  1920x1080 — main encode → HAL ch0
 *   group 1  dashcam_rtsp          1024x576  — RTSP vs1 → HAL ch1
 *   group 2  preview (/ai same res) 256x192  — LCD → HAL ch2 / CHN16
 *   group 3  1600x1200 — reserved (no stream references currently)
 *   group 4  480x288   — reserved (no stream references currently) */
"app_stream_usage": {
    "camera_app": {
        "roles_used": ["preview", "main", "picture"],
        "multimedia_set_camera_ai_enabled": false,
        "stream_reg_client": ["preview"],
        "main_vi_keepalive_on_preview": true,
        "notes": "Sub-channel preview feeds LCD for the whole session; capture/record use group 0 main stream."
    },
    "dashcam_app": {
        "roles_used": ["dashcam", "dashcam_rtsp", "preview", "picture"],
        "multimedia_set_camera_ai_enabled": false,
        "stream_reg_client": ["preview"],
        "sub_stream_reg_on_rtsp_play": true,
        "notes": "Record via LoopVideo; still capture key90→Photo/; RTSP=group1 1024x576."
    },
    "settings_lv_video_ctrl": {
        "roles_used": ["preview"],
        "multimedia_set_camera_ai_enabled": false,
        "stream_reg_client": ["preview"],
        "notes": "Settings page small-window preview"
    }
},
